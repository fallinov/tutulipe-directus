# Directus — Variables d'environnement
# Copier vers .env et remplir les valeurs

# Sécurité (générer avec : openssl rand -hex 32)
DIRECTUS_SECRET=

# Admin initial (première exécution uniquement)
ADMIN_EMAIL=admin@tutulipe.ch
ADMIN_PASSWORD=

# Base de données PostgreSQL
DB_USER=directus
DB_PASSWORD=
DB_DATABASE=tutulipe

# URL publique (adapter en production)
PUBLIC_URL=http://localhost:8055

# CORS — URL du frontend
CORS_ORIGIN=http://localhost:3000

# Port Directus
PORT=8055

# Logs (info, warn, error)
LOG_LEVEL=info
